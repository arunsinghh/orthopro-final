# OrthoPro India — environment configuration template.
# Copy to `.env` and fill real values. NEVER commit `.env`.
# Do NOT put real credentials in this example file.

# development | testing | production
FLASK_ENV=production

# Long random string (>=32 chars). Generate:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL connection for the app (least-privilege user, NOT the postgres superuser)
DATABASE_URL=postgresql://orthopro_app:orthopro_app@127.0.0.1:5432/orthopro

# Optional overrides
# UPLOAD_DIR=/var/lib/orthopro/uploads
# MAX_UPLOAD_MB=50
# SESSION_LIFETIME_SECONDS=28800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# LOG_FILE=/var/log/orthopro/app.log
# TRUST_PROXY=1

# Backups (used by scripts/backup.sh)
# BACKUP_DIR=/var/backups/orthopro
# BACKUP_PASSPHRASE=replace-with-a-strong-passphrase
# BACKUP_RETENTION_DAYS=14

# ---------------- Meta lead integration (fill when going live) ----------------
# Never commit real values. Leave empty to keep the webhook disabled (503).
# META_APP_SECRET=           # Meta app secret (webhook signature verification)
# META_VERIFY_TOKEN=         # any string you choose (webhook GET verification)
# META_ACCESS_TOKEN=         # Graph API system-user token (lead field fetch)
# META_PAGE_ID=              # Facebook Page ID
# META_INSTAGRAM_BUSINESS_ID=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_GRAPH_VERSION=v21.0
# META_AUTO_FOLLOWUP_DAYS=0  # >0 auto-creates a first follow-up for Meta leads
